# Copy to .env (git-ignored) and fill in your own keys. Never commit .env.

# Required: paid fallback and the seats NVIDIA does not serve (Kimi K3, GLM 5.3, DeepSeek).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: NVIDIA NIM free tier, tried first for seats it serves.
NVIDIA_API_KEY=nvapi-...

# Optional server settings (defaults shown by the code if unset).
# COUNCIL_HOST=127.0.0.1
# COUNCIL_PORT=8001
# COUNCIL_RELOAD=1
# COUNCIL_CORS_ORIGINS=http://localhost:5173
